exports[`ComponentTagger output > tags page 1`] = `
"import { useState } from "react";
import { Card } from "@/components/ui/card";
import * as React from "react";

type Item = { id: string; title: string; done: boolean };

export default function Dashboard({ items }: { items: Item[] }) {
  const [filter, setFilter] = useState<"all" | "done">("all");
  const visible = items.filter((item) => filter === "all" || item.done);
  return (
    <main data-hercules-id="src/pages/Dashboard.tsx:11:4" data-hercules-name="main" className="flex flex-col gap-4 p-6">
      <header data-hercules-id="src/pages/Dashboard.tsx:12:6" data-hercules-name="header" className={\`title \${filter}\`}>
        <h1 data-hercules-id="src/pages/Dashboard.tsx:13:8" data-hercules-name="h1">Dashboard</h1>
        <button data-hercules-id="src/pages/Dashboard.tsx:14:8" data-hercules-name="button" type="button" onClick={() => setFilter(filter === "all" ? "done" : "all")}>
          Show {filter === "all" ? "done" : "all"}
        </button>
      </header>
      {visible.length === 0 ? (
        <p data-hercules-id="src/pages/Dashboard.tsx:19:8" data-hercules-name="p" className="text-muted">Nothing here yet.</p>
      ) : (
        <ul data-hercules-id="src/pages/Dashboard.tsx:21:8" data-hercules-name="ul">
          {visible.map((item) => (
            <li data-hercules-id="src/pages/Dashboard.tsx:23:12" data-hercules-name="li" key={item.id} {...{ "data-done": item.done }}>
              <Card.Header data-hercules-id="src/pages/Dashboard.tsx:24:14" data-hercules-name="Card.Header">{item.title}</Card.Header>
              <React.Fragment>
                <input data-hercules-id="src/pages/Dashboard.tsx:26:16" data-hercules-name="input" type="checkbox" checked={item.done} readOnly />
              </React.Fragment>
            </li>
          ))}
        </ul>
      )}
      <>
        <footer data-hercules-id="src/pages/Dashboard.tsx:33:8" data-hercules-name="footer" />
      </>
    </main>
  );
}
"
`;

