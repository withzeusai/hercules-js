{
  "name": "@usehercules/agents",
  "version": "0.3.0",
  "description": "Hercules agents in a Hercules app: talk to an agent from a Convex app, with TanStack AI or React, and serve it the app's tools over MCP",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./convex": "./dist/convex.mjs",
    "./convex.config": {
      "types": "./dist/component/convex.config.d.ts",
      "default": "./dist/component/convex.config.js"
    },
    "./convex.config.js": {
      "types": "./dist/component/convex.config.d.ts",
      "default": "./dist/component/convex.config.js"
    },
    "./_generated/component": {
      "types": "./dist/component/_generated/component.d.ts"
    },
    "./_generated/component.js": {
      "types": "./dist/component/_generated/component.d.ts"
    },
    "./react": "./dist/react.mjs",
    "./tanstack": "./dist/tanstack.mjs",
    "./package.json": "./package.json"
  },
  "author": "Hercules Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/withzeusai/hercules-js.git",
    "directory": "packages/agents"
  },
  "files": [
    "dist",
    "src",
    "!src/__tests__",
    "tsconfig.json",
    "tsdown.config.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest --run"
  },
  "peerDependencies": {
    "@tanstack/ai": "^1.2.0",
    "@tanstack/ai-client": "^1.1.0",
    "convex": "^1.29.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/ai": {
      "optional": true
    },
    "@tanstack/ai-client": {
      "optional": true
    },
    "convex": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tanstack/ai": "1.2.0",
    "@tanstack/ai-client": "1.1.0",
    "@tanstack/ai-react": "1.0.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "convex": "^1.47.0",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
