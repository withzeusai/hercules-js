{
  "name": "@usehercules/auth-core",
  "version": "0.0.0",
  "description": "Framework-agnostic embedded sign-in client for Hercules applications",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./dist/index.mjs",
    "./react": "./dist/react/index.mjs",
    "./package.json": "./package.json"
  },
  "author": "Hercules Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/withzeusai/hercules-js.git",
    "directory": "packages/auth-core"
  },
  "files": [
    "dist",
    "src",
    "styles.css",
    "tsconfig.json",
    "tsdown.config.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest --run"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^29.1.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tsdown": "^0.22.8",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
